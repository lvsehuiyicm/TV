<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
    <!-- 0.1.135：底部药丸按 xu 新参考图（1000247835_86_0f1k.jpg，930x2048）重做，
         仍只留 首页/直播/我的 3 个菜单。
         参考图实测（约 2.2 图像 px = 1dp）：药丸 x 85–845（宽 760px，占屏宽 81.7%，
         边距各约 85px）、y 1843–1970（高约 127px ≈ 58dp）、底边距约 78px ≈ 35dp；
         图标约 44–53x38–48px（≈20dp）、汉字约 48–51x22–24px（≈11sp）。
         0.1.135 落点：边距 39dp、底边距 35dp、图标 20dp、汉字接上已有的
         TextAppearance.Zhulong.NavLabel（11sp）、图标-汉字间距
         app:activeIndicatorLabelPadding="2dp"、itemPaddingTop 8dp、itemPaddingBottom 7dp。
         选中态：图标后面的小药丸底色已关掉（HomeActivity.setItemActiveIndicatorEnabled(false)，
         MDC 1.14 没有这个 XML 属性，只有 Java 方法）。
         0.1.136（xu 验 0.1.135 的反馈，2026-11-28 23:48：药丸上下距离严格按第一张图做，
         点击菜单没变颜色；加载源问题后做，这版不动）：
         (1) 药丸太高：0.1.135 录屏实测药丸 y 1337–1477、高 141px（屏 720x1584），
         占屏高 8.9%，参考图是 6.2%；内容只占 y 1357–1420，图标上留白 20px、汉字下
         留白 57px——多出来的约 16dp 全在汉字下面。查 MDC 1.14.0 源码 + AAR 布局：
         item 的 labelGroup（BaselineLayout）在 design_bottom_navigation_item.xml 里
         自带 android:paddingBottom="@dimen/m3_bottom_nav_item_padding_bottom"（=16dp），
         两版实测的底部留白都符合“16dp + itemPaddingBottom”同时存在
         （0.1.133：16+0，留白 42px；0.1.135：16+7，留白 57px），
         所以 0.1.136 把这份 MDC 布局整个覆盖进 app（同名文件
         design_bottom_navigation_item.xml，只把那行 paddingBottom 改成 0dp），
         底部留白从此只由 app:itemPaddingBottom 控制。
         (2) 药丸略窄：0.1.135 药丸 x 80–640、宽 561px，占屏宽 77.9%，参考图 81.7%；
         边距 39dp 渲出来是屏宽的 11.1%，参考图边距占 9.14%——边距 39dp → 32dp
         （32dp × 2.05px/dp ≈ 66px，目标边距 85/930×720 ≈ 66px）。
         (3) 高度落点（覆盖生效后）：6（顶）+20（图标）+2（间距）+16（汉字行高）
         +4（底）= 48dp，占屏高 6.2%，与参考图比例一致；仍是 wrap_content，
         不定死高度（0.1.132 的 46dp 裁汉字教训）。
         选中变色见 selector_nav.xml（0.1.136 改）。底边距 35dp 不动。 -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="35dp"
        android:background="@drawable/shape_nav_pill"
        android:minHeight="44dp"
        app:elevation="8dp"
        app:itemIconSize="20dp"
        app:itemIconTint="@color/selector_nav"
        app:itemTextColor="@color/selector_nav"
        app:itemTextAppearanceActive="@style/TextAppearance.Zhulong.NavLabel"
        app:itemTextAppearanceInactive="@style/TextAppearance.Zhulong.NavLabel"
        app:activeIndicatorLabelPadding="2dp"
        app:itemPaddingBottom="4dp"
        app:itemPaddingTop="6dp"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_nav"/>
</RelativeLayout>
