<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
    <!-- 0.1.134：内容不再 layout_above 导航栏，容器改为全高，药丸悬浮在内容之上，
         药丸下面 16dp 的底边距就能露出来一点海报（对着参考图：他家药丸底边到屏幕底
         约 14–26dp，烛龙 16dp 在这个区间里）。首页 sections 的 paddingBottom 同步
         加到 88dp（见 fragment_vod.xml），最后一行海报才能完全滚到药丸上面。
         itemPaddingTop 4dp → 10dp：0.1.133 实测药丸里图标+汉字整体偏上约 11–13px
         （内容中心比药丸中心高约 6dp），顶部多 6dp 就把内容推到正中间。
         仍是 wrap_content，不用固定死高度（0.1.132 的 46dp 教训），汉字不裁。 -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/shape_nav_pill"
        android:minHeight="44dp"
        app:elevation="8dp"
        app:itemActiveIndicatorStyle="@style/Widget.Zhulong.NavActiveIndicator"
        app:itemIconSize="18dp"
        app:itemIconTint="@color/selector_nav"
        app:itemTextColor="@color/selector_nav"
        app:itemPaddingBottom="0dp"
        app:itemPaddingTop="10dp"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_nav"/>
</RelativeLayout>
