<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/navigation"/>
    <!-- 0.1.133：layout_height 改回 wrap_content。0.1.132 定死 46dp 是错的：BottomNavigationView
         有图标+汉字两行，自然高度约 56dp（0.1.131 wrap_content 时汉字完整显示就是证据），
         46dp 直接把汉字那一行裁没了（xu 录屏已证实：药丸里只剩 3 个图标、没有汉字）。
         教训：不要用固定死高度去赌内容高度，汉字完整显示是硬要求、1 毫米留白是软要求。
         itemPaddingBottom 保持 0dp（0.1.132 的改动，不裁字的前提下尽量收底边留白）、
         itemPaddingTop 4dp、minHeight 44dp 留着（小于自然高度，不起作用）。 -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/shape_nav_pill"
        android:minHeight="44dp"
        app:elevation="8dp"
        app:itemActiveIndicatorStyle="@style/Widget.Zhulong.NavActiveIndicator"
        app:itemIconSize="18dp"
        app:itemIconTint="@color/selector_nav"
        app:itemTextColor="@color/selector_nav"
        app:itemPaddingBottom="0dp"
        app:itemPaddingTop="4dp"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_nav"/>
</RelativeLayout>
