<?xml version="1.0" encoding="utf-8"?>
<!-- 竖屏直播分组网格的格子（0.1.102：分组从横向一排 tab 改成 4 列网格，全部的分全露出来，
     四方格图标拿掉；字比下边频道胶囊大一号（频道最大 10sp，分组最大 11sp）且加黑，
     点哪个分组就只显示那个分组的频道，其他分组的频道不出现）。
     底色和字色由 GroupPortAdapter 在绑定时直接按选中态换（0.1.101 起不再靠 selector / selected 状态，
     0.1.100 之前那条链路在真机上没起作用，分组 tab 的琥珀色卡在"央视频道"不动）。
     singleLine 换成 maxLines="1"（singleLine 会打开横向滚动、顶掉 auto-size，0.1.100 网格名字缩不下来就是这个原因）。 -->
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="2dp"
    android:gravity="center"
    android:orientation="horizontal">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:duplicateParentState="true"
        android:ellipsize="none"
        android:gravity="center"
        android:maxLines="1"
        android:paddingStart="6dp"
        android:paddingTop="8dp"
        android:paddingEnd="6dp"
        android:paddingBottom="8dp"
        android:textStyle="bold"
        app:autoSizeMaxTextSize="11sp"
        app:autoSizeMinTextSize="8sp"
        app:autoSizeStepGranularity="1sp"
        app:autoSizeTextType="uniform"
        tools:text="央视频道" />

</androidx.appcompat.widget.LinearLayoutCompat>
