<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true">

    <!-- 竖屏：视频在上 + 竖屏面板在下；横屏：视频全屏，面板隐藏 -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/video"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/black"
            android:clickable="true"
            android:focusable="true">

            <androidx.media3.ui.PlayerView
                android:id="@+id/player"
                style="@style/Player.Live"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:surface_type="none" />

            <include
                android:id="@+id/widget"
                layout="@layout/view_widget_live"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <include
                android:id="@+id/control"
                layout="@layout/view_control_live"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <include
                android:id="@+id/progress"
                layout="@layout/view_progress"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- 竖屏全屏入口（0.1.101）：视频右下角的小全屏图标，点一下进横屏；控制栏打开时由代码把它藏起来
                 （控制栏底部本来就有全屏按钮），控制栏收起时再显示；双击视频也是进全屏（见 LiveActivity.onDoubleTap）。
                 背景是半透明黑圆（shape_control），在视频上看得清；图标是控制栏全屏按钮同款。 -->
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnPortFullscreen"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/shape_control"
                android:src="@drawable/ic_control_fullscreen"
                android:tint="@color/white" />

        </FrameLayout>

        <!-- 竖屏面板：0.1.118 起固定深色底，不跟主题壁纸 -->
        <FrameLayout
            android:id="@+id/portrait"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/live_dark_bg"
            android:visibility="gone"
            tools:visibility="visible">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="24dp">

                <!-- 频道号 + 来源行 -->
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/portIcon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/shape_live_circle_outline"
                        android:padding="15dp"
                        android:src="@drawable/exo_icon_play"
                        android:tint="@color/white" />

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/portNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            tools:text="001" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/portSource"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white_70"
                            android:textSize="13sp"
                            tools:text="来源：电视 类型：直播列表" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                </androidx.appcompat.widget.LinearLayoutCompat>

                <!-- 0.1.118：节目卡（当前节目＋进度＋接下来）；无 EPG 时只显示频道名，进度与接下来行隐藏，卡片本身保留。 -->
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/cardPortProgram"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/shape_live_card_dark"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/portProgTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <ProgressBar
                        android:id="@+id/portProgBar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_marginTop="8dp"
                        android:max="100"
                        android:progressBackgroundTint="@color/live_dark_pill"
                        android:progressTint="@color/live_selected" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/portProgNext"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/white_70"
                        android:textSize="13sp" />

                </androidx.appcompat.widget.LinearLayoutCompat>

                <!-- 分组网格（0.1.102：四方格图标拿掉，分组从横向一排 tab 改成 4 列网格，全部的分全露出来；
                     点哪个分组就只显示那个分组的频道，其他分组的频道不出现；分组字比下边频道大一号且加黑，
                     见 adapter_group_port.xml。列数在 LiveActivity.setPortraitView 里定成 4 列） -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/groupPort"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    tools:itemCount="7"
                    tools:listitem="@layout/adapter_group_port" />

                <!-- 频道网格（4 列，可滚动） -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/channelPort"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="8dp"
                    android:layout_weight="1"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:padding="4dp"
                    tools:itemCount="12"
                    tools:listitem="@layout/adapter_channel_grid" />

            </androidx.appcompat.widget.LinearLayoutCompat>

        </FrameLayout>

    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/recycler"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:background="@drawable/shape_live_list"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/group"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:padding="8dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:itemCount="5"
            tools:listitem="@layout/adapter_group" />

        <!-- 横屏侧边列表：分组栏 + 频道栏 + EPG 栏。0.1.101：频道栏去掉 translationX="-16dp"——它把频道栏整列往左挪 16dp、
             压到分组栏上，底部最后一行（"数字…"和"014 CCTV-1综合"）在同一高度左右重叠。 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/channel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:padding="8dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:itemCount="5"
            tools:listitem="@layout/adapter_channel" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/epgData"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:padding="8dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:itemCount="5"
            tools:listitem="@layout/adapter_epg_data" />

    </androidx.appcompat.widget.LinearLayoutCompat>
</FrameLayout>
