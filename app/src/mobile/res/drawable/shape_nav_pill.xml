<?xml version="1.0" encoding="utf-8"?>
<!-- 0.1.131：首页底部导航的悬浮药丸背景。磨砂玻璃：底色是 ?attr/colorSurface 在 0.72 透明度下
     的半透明（@color/nav_pill_frost），亮色下是半透明白、深色下是半透明深灰——下面的海报透出来
     但被蒙上雾面，不是实心白底，也不会在深色下变成刺眼的白块。1dp 淡白描边让药丸在杂乱海报上
     仍有轮廓。阴影由 BottomNavigationView 的 elevation 给。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="24dp" />
    <solid android:color="@color/nav_pill_frost" />
    <stroke
        android:width="1dp"
        android:color="@color/white_20" />
</shape>
