<?xml version="1.0" encoding="utf-8"?>
<!-- 0.1.133：首页底部导航的悬浮药丸背景。圆角由 24dp 改成 28dp——参考图（234802689_83_w4um.jpg）
     的药丸高约 57dp、两端是全圆角（半圆端头），28dp 接近半高，最接近参考图那种“胶囊”观感。
     磨砂玻璃：底色是 ?attr/colorSurface 在 0.85 透明度下的半透明（@color/nav_pill_frost，
     按参考图实测定：药丸中心约 (239,240,244)，海报只透出淡淡色块），亮色下是半透明白、
     深色下是半透明深灰。1dp 淡白描边让药丸在杂乱海报上仍有轮廓。阴影由 BottomNavigationView 的 elevation 给。
     选中态颜色仍是烛龙自己的琥珀（selector_nav 用 ?attr/colorPrimary），没照搬参考图的蓝色。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="28dp" />
    <solid android:color="@color/nav_pill_frost" />
    <stroke
        android:width="1dp"
        android:color="@color/white_20" />
</shape>
