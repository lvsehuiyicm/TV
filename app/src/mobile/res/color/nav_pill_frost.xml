<?xml version="1.0" encoding="utf-8"?>
<!-- 0.1.131：底部导航药丸的磨砂玻璃底色。?attr/colorSurface 跟主题走（亮色近白、深色深灰），
     alpha 0.72 让它半透明：下面的海报透出来但被蒙上一层雾面，看着是磨砂玻璃，不是实心白底。
     真逐像素模糊做不到（见 NOTES）：RenderEffect 会把导航自己的图标汉字也糊掉；加第三方模糊库
     要改 build.gradle 依赖；Window 模糊只对窗口（弹窗）生效，不是对 Activity 里的一个 View。
     所以用半透明底色做到最接近磨砂的观感。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:alpha="0.72" android:color="?attr/colorSurface" />
</selector>
